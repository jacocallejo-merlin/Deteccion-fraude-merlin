# Copia este fichero como .env y ajusta los valores.
# La contraseña tiene que coincidir con la de docker-compose.yml.
CLICKHOUSE_PASSWORD=password
# Opcionales (si no se ponen, se usan los de config.yaml)
# CLICKHOUSE_USER=default
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DATABASE=fraude_pagos

# Notificaciones (pipeline/notificar.py): avisos de fraude, fallos del pipeline y drift.
# Cada usuario de la web elige en "Mis avisos" (el engranaje) si los recibe en su correo y en su Teams.
# Aquí van los canales del servidor, que reciben todo (p. ej. el canal del equipo de fraude), y sobre
# todo el servidor de correo (SMTP_*), que es del proveedor y sirve para enviar a todos los usuarios.
# Opcionales: lo que no se ponga no se usa. Probar con:  python pipeline/notificar.py --prueba
# Teams: en el canal, Flujos de trabajo > "Publicar en un canal cuando se recibe una solicitud de webhook"
# TEAMS_WEBHOOK_URL=https://...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Correo por SMTP con STARTTLS (con Gmail hace falta una "contraseña de aplicación")
# SMTP_SERVIDOR=smtp.office365.com
# SMTP_PUERTO=587
# SMTP_USUARIO=usuario@dominio.com
# SMTP_PASSWORD=...
# CORREO_REMITENTE=usuario@dominio.com
# CORREO_DESTINATARIOS=analista1@dominio.com,analista2@dominio.com
